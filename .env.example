NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs: run `python scripts/list_models.py` and copy the exact IDs here.
MODEL_EXTRACT=        # Nemotron Nano: claim extraction (high volume, cheap)
MODEL_JUDGE=          # Nemotron Super: verdicts
MODEL_ESCALATE=       # Nemotron Ultra: full-paper second opinion
MODEL_VISION=         # Nemotron Nano Omni: scanned pages / figures (optional)
MODEL_EMBED=          # an embedding model available on Token Factory

# How reasoning is switched on/off for Nemotron models:
#   chat_template_kwargs  -> extra_body={"chat_template_kwargs": {"enable_thinking": bool}} (Nemotron 3)
#   system_prompt         -> "/think" or "/no_think" system message (older Nemotron Nano v2)
#   none                  -> send nothing
REASONING_CONTROL=chat_template_kwargs

MAX_CONCURRENCY=8
CACHE_DIR=.cache
DB_PATH=.cache/app.sqlite
CONTACT_EMAIL=        # sent in User-Agent / mailto for OpenAlex and Crossref polite pools
ARXIV_MIN_INTERVAL=3  # seconds between arxiv.org requests (arXiv asks for one every 3 seconds)

# Estimated USD price per 1M tokens, per role (for the cost panel). Check Token Factory pricing.
PRICE_EXTRACT_IN=0
PRICE_EXTRACT_OUT=0
PRICE_JUDGE_IN=0
PRICE_JUDGE_OUT=0
PRICE_ESCALATE_IN=0
PRICE_ESCALATE_OUT=0
PRICE_VISION_IN=0
PRICE_VISION_OUT=0
PRICE_EMBED_IN=0

# Limits (section 10)
QUICK_CHECK_MAX_CITATIONS=20
MAX_REFERENCES=150
MAX_PDF_MB=25
MAX_JOBS_PER_IP_PER_HOUR=5     # new checks per IP (reopening a cached result is free)
MAX_PREVIEWS_PER_IP_PER_HOUR=30  # paper look-ups that download from arXiv
MAX_CONCURRENT_JOBS=3
MAX_TOKENS_PER_JOB=5000000  # uncached tokens; a full check of a 70-citation paper uses ~1.5M. 0 = unlimited
JUDGE_MODE_PASSWORD=  # if set, full checks need this passcode; quick checks and the demo stay open
GROBID_URL=
# Behind a reverse proxy you trust, rate-limit by X-Forwarded-For instead of the socket address.
TRUST_PROXY_HEADERS=false

# Retrieval query instruction for instruction-aware embedders (Qwen3-Embedding).
# Leave unset for the built-in default; set to "none" for embedders that take raw text.
EMBED_QUERY_INSTRUCTION=

# Claim extraction runs Nemotron Nano with reasoning off (fast, cheap). Set to true to trade
# ~5x more output tokens and ~2.5x latency for somewhat better attribution on hard sentences.
REASONING_EXTRACT=false

# Characters of cited-paper text sent to the long-context escalation model (~4 chars per token).
ESCALATE_MAX_CHARS=300000
